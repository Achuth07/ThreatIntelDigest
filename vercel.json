{
  "version": 2,
  "name": "threat-intel-digest",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm ci",
  "devCommand": "npm run dev",
  "env": {
    "NPM_CONFIG_INCLUDE_STAGE_ALL": "true"
  },
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    },
    "api/page.ts": {
      "maxDuration": 10,
      "includeFiles": "dist/public/index.html"
    }
  },
  "crons": [
    {
      "path": "/api/cron/fetch-kev",
      "schedule": "0 0 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/vulnerabilities",
      "destination": "/cve",
      "permanent": true
    },
    {
      "source": "/vulnerabilities/:id",
      "destination": "/cve/:id",
      "permanent": true
    },
    {
      "source": "/exploited-vulnerabilities",
      "destination": "/cisa-kev",
      "permanent": true
    },
    {
      "source": "/exploited-vulnerabilities/:id",
      "destination": "/cve/:id",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).+)/",
      "destination": "/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap-core.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap-blog.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap-kev.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap-actors.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/:page(dashboard|threatfeed|watchlist|login|register|onboarding|forgot-password|reset-password|set-password|settings|admin|about|sources|contact|privacy|terms|report-bugs|blog|threat-actors|cve|cisa-kev)",
      "destination": "/api/page"
    },
    {
      "source": "/:section(article|blog|threat-actors|cve)/:id",
      "destination": "/api/page"
    }
  ],
  "headers": [
    {
      "source": "/api/rss/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/api/((?!rss/).*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://www.whatcyber.com"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(login|register|forgot-password|reset-password|set-password|onboarding|settings|watchlist|report-bugs)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(admin|article)/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "regions": [
    "iad1"
  ]
}